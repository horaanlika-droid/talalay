# ─── Only these three are needed on BotHost ────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-BotFather
ADMIN_ID=123456789            # your numeric Telegram ID (send /id to @userinfobot)
ADMIN_PASSWORD=change-me-please   # staff password for the bot

# ─── Optional, detected automatically in most cases ───────────────────────
# PORT=8080
# PUBLIC_API_URL=https://your-service.bothost.ru
# STOREFRONT_URL=https://horaanlika-droid.github.io/talalay
# CORS_ORIGINS=*
# AUTH_TTL_HOURS=72
# DB_PATH=/app/data/embassy.db
# MEDIA_DIR=/app/media
